{
  "name": "game-hub",
  "productName": "Game Hub",
  "version": "1.1.0",
  "description": "Game Hub: Spiele-Start und Synchronisation im lokalen Netzwerk",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "publish": "node scripts/publish.js",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "de.timhubert.gamehub",
    "files": ["**/*", "!dist/**", "!share/**", "!settings.json", "!games.json"],
    "win": { "target": "portable" }
  }
}
